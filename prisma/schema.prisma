// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConsultationType {
  CLINIC
  ONLINE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum BookingSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum UserRole {
  PATIENT
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  /// Null for OAuth-only accounts (e.g. Google sign-in).
  password  String?
  role      UserRole @default(PATIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Doctor {
  id              String               @id @default(cuid())
  name            String
  specialization  String
  image           String
  createdAt       DateTime             @default(now())
  availabilities  DoctorAvailability[]
  appointments    Appointment[]
  bookingSessions BookingSession[]
}

model DoctorAvailability {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  startTime String
  endTime   String
}

model Appointment {
  id               String            @id @default(cuid())
  doctorId         String
  doctor           Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientName      String
  email            String
  phone            String
  /// IANA timezone used when interpreting date + time for reminders (e.g. America/New_York)
  timezone         String            @default("UTC")
  date             DateTime          @db.Date
  time             String
  notes            String?
  consultationType ConsultationType
  status           AppointmentStatus @default(PENDING)
  paymentStatus    PaymentStatus     @default(PENDING)
  stripePaymentId  String?
  cancelToken      String?
  rescheduleToken  String?
  createdAt        DateTime          @default(now())
}

model BookingSession {
  id               String               @id @default(uuid())
  doctorId         String
  doctor           Doctor               @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patientName      String
  email            String
  phone            String
  /// IANA timezone for patient-local date/time (e.g. America/New_York)
  timezone         String               @default("UTC")
  date             String
  time             String
  notes            String?
  consultationType String
  status           BookingSessionStatus @default(PENDING)
  createdAt        DateTime             @default(now())
  expiresAt        DateTime
}
